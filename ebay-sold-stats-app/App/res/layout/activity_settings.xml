<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EBAY ACCOUNT (OPTIONAL)"
            android:textStyle="bold"
            android:textColor="#0a4fa0"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/input_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="eBay email"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/input_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="eBay password"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="Result pages to scan per marketplace (1-4):"
            android:textStyle="bold"
            android:textColor="#0a4fa0"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/input_pages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="1 to 4 - default 3"
            android:inputType="number"
            android:text="3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:text="Cookie fallback (copy of your logged-in browser session - used automatically if a marketplace returns 403): paste the EditThisCookie JSON export below."
            android:textStyle="bold"
            android:textColor="#0a4fa0"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/input_cookies"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:gravity="top"
            android:hint="Paste cookie JSON here (EditThisCookie export)"
            android:inputType="textMultiLine|textNoSuggestions"
            android:textSize="12sp"
            android:typeface="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:text="Custom catalog (optional - one search query per line, or franchise,character,goods,query lines; replaces the built-in 1500-query list when filled)"
            android:textStyle="bold"
            android:textColor="#0a4fa0"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/input_customlist"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:gravity="top"
            android:hint="Example:\ntanjiro peluche\nnenzuko badge\nsukuna figurine"
            android:inputType="textMultiLine|textNoSuggestions"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#0a4fa0"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:text="Save settings" />
    </LinearLayout>
</ScrollView>
