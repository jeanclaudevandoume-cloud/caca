<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/result_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="eBay Sold Stats"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#0a4fa0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#5f6672"
                android:text="Items sold in the last 90 days and median price for a title on an eBay marketplace." />

            <Spinner
                android:id="@+id/spinner_site"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/input_query"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search title, e.g. gojo satoru plush"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_extract"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="#0a4fa0"
                android:textColor="#ffffff"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:text="Extract sold stats" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:textColor="#5f6672"
                    android:text="Tip: add your eBay account in Settings once." />

                <TextView
                    android:id="@+id/btn_toggle_web"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0a4fa0"
                    android:text="Show browser" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/result_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SOLD IN THE LAST 90 DAYS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#8a919e" />

                <TextView
                    android:id="@+id/result_sold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    android:textColor="#0a4fa0"
                    android:text="0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="MEDIAN PRICE"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#8a919e" />

                        <TextView
                            android:id="@+id/result_median"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#21242b" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="QTY-WEIGHTED MEDIAN"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#8a919e" />

                        <TextView
                            android:id="@+id/result_median_w"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#21242b" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/result_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:textSize="12sp"
                    android:textColor="#5f6672" />
            </LinearLayout>

            <TextView
                android:id="@+id/result"
                style="@style/Result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:visibility="gone"
                android:textIsSelectable="true" />

            <LinearLayout
                android:id="@+id/result_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_batch"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:backgroundTint="#e8ecf1"
                    android:textColor="#21242b"
                    android:textAllCaps="false"
                    android:text="Batch: run 800-query catalog" />

                <Button
                    android:id="@+id/btn_share"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#e8ecf1"
                    android:textColor="#21242b"
                    android:textAllCaps="false"
                    android:text="Share CSV" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#e8ecf1"
                android:textColor="#21242b"
                android:textAllCaps="false"
                android:text="Settings (account, pages, cookie fallback)" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#ffffff"
        android:visibility="gone" />
</FrameLayout>
